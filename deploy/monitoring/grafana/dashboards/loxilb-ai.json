      },
      "panels": [
        {
          "id": 8,
          "type": "timeseries",
          "title": "Rate-limit hits/s",
          "description": "Denied requests are NOT counted in loxilb_ai_requests_total \u2014 this is the only place throttling is visible. Requires an AI API key carrying rate_limit_rps (POST /config/ai/apikey); 'No data' without keyed quota configured.",
          "gridPos": {
            "h": 8,
            "w": 12,
            "x": 0,
            "y": 31
          },
