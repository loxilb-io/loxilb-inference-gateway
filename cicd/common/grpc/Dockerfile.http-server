FROM golang:1.25-alpine AS builder

# Install protobuf compiler and tools
RUN apk add --no-cache protobuf protobuf-dev

# Set up work directory
WORKDIR /app

# Install Go protobuf plugins
RUN go install google.golang.org/protobuf/cmd/protoc-gen-go@v1.34.2 && \
    go install google.golang.org/grpc/cmd/protoc-gen-go-grpc@v1.5.1

# Copy proto file
COPY proto/helloworld.proto proto/

# Generate protobuf code
RUN protoc --go_out=. --go_opt=paths=source_relative \
    --go-grpc_out=. --go-grpc_opt=paths=source_relative \
    proto/helloworld.proto

# Copy HTTP server code
COPY grpc-server/http-server.go .

# Initialize go module
RUN go mod init grpc-hello && \
    go get google.golang.org/grpc@v1.80.0 && \
    go mod tidy

# Build HTTP server
RUN go build -o http-server http-server.go

# Final stage
FROM alpine:latest
RUN apk --no-cache add ca-certificates bash
WORKDIR /root/
COPY --from=builder /app/http-server .

EXPOSE 8080

ENTRYPOINT ["/bin/bash"]
