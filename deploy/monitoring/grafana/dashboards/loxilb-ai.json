    {
      "id": 16,
      "type": "row",
      "collapsed": true,
      "title": "KV-cache routing (tier-1.5)",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 29
      },
      "panels": [
        {
          "id": 17,
          "type": "timeseries",
          "title": "Tier-1.5 hits vs spills vs fallthrough/s",
          "description": "Aggregate comparison of tier-1.5 routing outcomes. hits/spills are summed across endpoints here (the underlying counters carry ep_idx); see 'Tier-1.5 hits by endpoint' for the per-endpoint split.",
          "gridPos": {
            "h": 8,
            "w": 12,
            "x": 0,
            "y": 38
          },
          "datasource": {
            "type": "prometheus",
            "uid": "loxilb-prom"
          },
          "targets": [
            {
              "refId": "A",
              "expr": "sum(rate(loxilb_pd_kv_tier15_hits_total{instance=~\"$instance\"}[$__rate_interval]))",
              "legendFormat": "hits"
            },
            {
              "refId": "B",
              "expr": "sum(rate(loxilb_pd_kv_tier15_spills_total{instance=~\"$instance\"}[$__rate_interval]))",
              "legendFormat": "spills"
            },
            {
              "refId": "C",
              "expr": "sum(rate(loxilb_pd_kv_tier15_fallthrough_total{instance=~\"$instance\"}[$__rate_interval]))",
              "legendFormat": "fallthrough"
            }
          ],
          "options": {
            "tooltip": {
              "mode": "multi"
            },
            "legend": {
              "displayMode": "list",
              "placement": "bottom"
            }
          },
          "fieldConfig": {
            "defaults": {
              "unit": "short",
              "noValue": "No data"
            },
            "overrides": []
          }
        },
        {
          "id": 18,
          "type": "timeseries",
          "title": "KV miss reasons/s",
          "gridPos": {
            "h": 8,
            "w": 12,
            "x": 12,
            "y": 38
          },
          "datasource": {
            "type": "prometheus",
            "uid": "loxilb-prom"
          },
          "targets": [
            {
              "refId": "A",
              "expr": "sum by (reason) (rate(loxilb_pd_kv_tier15_miss_reason_total{instance=~\"$instance\"}[$__rate_interval]))",
              "legendFormat": "{{reason}}"
            }
          ],
          "options": {
            "tooltip": {
