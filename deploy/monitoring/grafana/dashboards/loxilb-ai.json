            },
            {
              "refId": "C",
              "expr": "rate(loxilb_pd_kv_tier15_fallthrough_total{instance=~\"$instance\"}[$__rate_interval])",
              "legendFormat": "fallthrough"
            }
          ],
          "options": {
            "tooltip": {
              "mode": "multi"
            },
