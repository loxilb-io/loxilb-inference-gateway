        },
        {
          "id": 9,
          "type": "timeseries",
          "title": "Model-not-allowed/s",
          "description": "Requires an AI API key with an allowed_models list (POST /config/ai/apikey); the request must carry that key so llb_ai_validate_key can reject a disallowed model. 'No data' without keyed allow-list. NOTE: the apikey REST endpoint is unimplemented on some images (returns 422/'not yet implemented').",
          "gridPos": {
            "h": 8,
