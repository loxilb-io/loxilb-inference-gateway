# Configuration for igw-testbed.sh. Copy to testbed.env, edit, then:
#   ./igw-testbed.sh -c testbed.env up
# Every setting can also be given as an environment variable.

# Required ------------------------------------------------------------------
# An address of the node loxilb runs on: fullproxy binds the listener to it.
VIP=192.168.80.90
# kube-loxilb with the Endpoint Picker and auth-annotation support
# (feat/auth-annotation). No published tag carries it yet: build it and push it
# to a registry the nodes can pull from, or import it on LOXILB_NODE and set
# KLB_PULL_POLICY=Never.
KLB_IMAGE=registry.example.com/kube-loxilb:auth-annotation-3c98a39

# Placement -----------------------------------------------------------------
# kubernetes.io/hostname of the node that owns VIP. loxilb and kube-loxilb are
# pinned there; empty runs loxilb on every control-plane node.
LOXILB_NODE=
#KLB_PULL_POLICY=IfNotPresent
#LISTENER_PORT=8080

# Images ---------------------------------------------------------------------
#IGW_IMAGE=ghcr.io/loxilb-io/loxilb-inference-gateway:latest
#SIM_IMAGE=ghcr.io/llm-d/llm-d-inference-sim:v1.0.0
#KC_IMAGE=quay.io/keycloak/keycloak:26.0
#PG_IMAGE=postgres:18.6

# Endpoint Picker -----------------------------------------------------------
#LLMD_REF=v1.0.0
#EPP_IMAGE_TAG=v1.0.0
#EPP_FAILURE_MODE=FailClose

# Names ------------------------------------------------------------------------
#RELEASE=igw
#RELEASE_NS=kube-system
#LLM_NS=llm
#AIGW_NS=aigw
#POOL=sim-pool
#MODEL=llama-70b

# Extra values file for the gateway chart, applied after the generated one.
#EXTRA_VALUES=
