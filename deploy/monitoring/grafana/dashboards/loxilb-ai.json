{
  "title": "LoxiLB / AI Gateway",
  "uid": "loxilb-ai",
  "tags": [
    "loxilb",
    "ai"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "editable": true,
  "graphTooltip": 1,
  "links": [
    {
      "type": "dashboards",
      "title": "LoxiLB dashboards",
      "tags": [
        "loxilb"
      ],
      "asDropdown": true,
      "includeVars": true,
      "keepTime": true,
      "icon": "external link",
      "targetBlank": false,
      "url": ""
    }
  ],
  "templating": {
    "list": [
      {
        "name": "instance",
        "label": "Instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "loxilb-prom"
        },
        "query": {
          "query": "label_values(up{job=\"loxilb\"}, instance)",
          "refId": "StandardVariableQuery"
        },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      },
      {
        "name": "model",
        "label": "Model",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "loxilb-prom"
        },
        "query": {
          "query": "label_values(loxilb_ai_requests_total, model)",
          "refId": "StandardVariableQuery"
        },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      },
      {
        "name": "tenant",
        "label": "Tenant",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "loxilb-prom"
        },
        "query": {
          "query": "label_values(loxilb_ai_requests_total, tenant)",
          "refId": "StandardVariableQuery"
        },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "AI error ratio (non-2xx, 5m)",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "loxilb-prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(rate(loxilb_ai_requests_total{status!~\"2..\",instance=~\"$instance\"}[5m])) or vector(0)) / sum(rate(loxilb_ai_requests_total{instance=~\"$instance\"}[5m]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "No data",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "#EAB839",
                "value": 0.01
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          }
        },
        "overrides": []
      },
      "description": "Shows 0 when traffic is healthy; No data only when there is no AI traffic at all."
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Active SSE streams",
      "description": "Streams open at the scrape instant (10s sampling). Short streams that start and finish between scrapes are not visible here - 0 is normal when the backend completes streams quickly; see the requests/s panels for volume and the trend panel for history.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "loxilb-prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "loxilb_ai_active_streams{instance=~\"$instance\"}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "KV subscribers up",
      "description": "KV-cache routing health. ZMQ deployments: min(loxilb_kv_subscriber_connected) across prefill EPs (1=all connected, 0=any rebuilding). Falls back to loxilb_kv_agent_up for REST auto-discovery deployments. NOTE: loxilb_kv_agent_up alone reads DOWN on a ZMQ KV-exact deployment even when routing is fully healthy \u2014 subscriber_connected is the correct signal there.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "loxilb-prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "min(loxilb_kv_subscriber_connected{instance=~\"$instance\"}) or on() max(loxilb_kv_agent_up{instance=~\"$instance\"})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "No data",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN"
                },
                "1": {
                  "text": "UP"
                }
              }
            }
          ]
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "AI requests/s by model",
      "description": "Counter increments at SSE stream COMPLETION \u2014 long streams appear only when they finish.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "loxilb-prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (model) (rate(loxilb_ai_requests_total{model=~\"$model\",tenant=~\"$tenant\",instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "{{model}}"
        }
      ],
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "No data"
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "AI requests/s by status",
      "description": "Real backend status codes (post-audit).",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "loxilb-prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(loxilb_ai_requests_total{model=~\"$model\",tenant=~\"$tenant\",instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "{{status}}"
        }
      ],
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "No data"
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Request duration p95 by model",
      "description": "Buckets reach 300 s for SSE streams.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": "loxilb-prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (model, le) (rate(loxilb_ai_request_duration_seconds_bucket{model=~\"$model\",instance=~\"$instance\"}[$__rate_interval])))",
          "legendFormat": "{{model}}"
        }
      ],
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "No data"
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Request duration distribution (p50/p90/p99)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": "loxilb-prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(loxilb_ai_request_duration_seconds_bucket{instance=~\"$instance\"}[$__rate_interval])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.90, sum by (le) (rate(loxilb_ai_request_duration_seconds_bucket{instance=~\"$instance\"}[$__rate_interval])))",
          "legendFormat": "p90"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(loxilb_ai_request_duration_seconds_bucket{instance=~\"$instance\"}[$__rate_interval])))",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "description": "Latency spread from loxilb_ai_request_duration_seconds histogram. (Replaces the classic-histogram heatmap, which does not render reliably in Grafana 11.)"
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Active SSE streams (trend)",
      "description": "History of the instantaneous gauge (10s samples). Sub-second streams rarely overlap a scrape.",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 20
      },
      "datasource": {
        "type": "prometheus",
        "uid": "loxilb-prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "loxilb_ai_active_streams{instance=~\"$instance\"}"
        }
      ],
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data"
        },
        "overrides": []
      }
    },
    {
      "id": 12,
      "type": "row",
      "collapsed": true,
      "title": "PD disaggregation (only on PD deployments)",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 28
      },
      "panels": [
        {
          "id": 13,
          "type": "timeseries",
          "title": "PD requests/s",
          "gridPos": {
