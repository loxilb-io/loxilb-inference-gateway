    {
      "id": 16,
      "type": "row",
      "collapsed": true,
      "title": "KV-cache routing (tier-1.5)",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 29
      },
      "panels": [
        {
          "id": 17,
          "type": "timeseries",
          "title": "Tier-1.5 hits vs spills vs fallthrough/s",
          "gridPos": {
            "h": 8,
            "w": 12,
            "x": 0,
            "y": 38
          },
          "datasource": {
            "type": "prometheus",
            "uid": "loxilb-prom"
          },
          "targets": [
            {
              "refId": "A",
              "expr": "rate(loxilb_pd_kv_tier15_hits_total{instance=~\"$instance\"}[$__rate_interval])",
              "legendFormat": "hits"
            },
            {
              "refId": "B",
              "expr": "rate(loxilb_pd_kv_tier15_spills_total{instance=~\"$instance\"}[$__rate_interval])",
