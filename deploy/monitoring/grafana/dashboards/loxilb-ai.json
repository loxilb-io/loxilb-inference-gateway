    {
      "id": 19,
      "type": "row",
      "collapsed": true,
      "title": "Requires AI controller / API-key security (not in pure-loxilb baseline)",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 30
      },
      "panels": [
        {
          "id": 11,
          "type": "timeseries",
          "title": "TTFT prediction error p90",
          "description": "Emitted by the loxilb-ai-controller (aictrl_* metrics) \u2014 a SEPARATE component with its own metrics endpoint, NOT the loxilb data plane. 'No data' unless you deploy that controller AND add it as its own Prometheus scrape job (the $instance var only covers job=loxilb).",
          "gridPos": {
            "h": 8,
            "w": 12,
            "x": 0,
            "y": 31
          },
          "datasource": {
            "type": "prometheus",
            "uid": "loxilb-prom"
          },
          "targets": [
            {
              "refId": "A",
              "expr": "aictrl_ttft_pred_err_ratio_p90{instance=~\"$instance\"}"
            }
          ],
          "options": {
            "tooltip": {
              "mode": "multi"
            },
            "legend": {
              "displayMode": "list",
              "placement": "bottom"
            }
          },
          "fieldConfig": {
            "defaults": {
              "unit": "short",
              "noValue": "No data"
            },
            "overrides": []
          }
        },
        {
          "id": 8,
          "type": "timeseries",
          "title": "Rate-limit hits/s",
          "description": "Denied requests are NOT counted in loxilb_ai_requests_total \u2014 this is the only place throttling is visible. Requires an AI API key carrying rate_limit_rps (POST /config/ai/apikey); 'No data' without keyed quota configured.",
          "gridPos": {
            "h": 8,
            "w": 12,
            "x": 12,
            "y": 31
          },
          "datasource": {
            "type": "prometheus",
            "uid": "loxilb-prom"
          },
          "targets": [
            {
              "refId": "A",
