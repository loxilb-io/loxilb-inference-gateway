          "options": {
            "tooltip": {
              "mode": "multi"
            },
            "legend": {
              "displayMode": "list",
              "placement": "bottom"
            }
          },
          "fieldConfig": {
            "defaults": {
              "unit": "reqps",
              "noValue": "No data"
            },
            "overrides": []
          }
        },
        {
          "id": 14,
          "type": "timeseries",
          "title": "Prefill duration p95",
          "gridPos": {
            "h": 8,
            "w": 12,
            "x": 12,
            "y": 37
          },
          "datasource": {
            "type": "prometheus",
            "uid": "loxilb-prom"
          },
          "targets": [
            {
              "refId": "A",
              "expr": "histogram_quantile(0.95, sum by (le) (rate(loxilb_ai_pd_prefill_duration_seconds_bucket{instance=~\"$instance\"}[$__rate_interval])))"
            }
          ],
          "options": {
            "tooltip": {
              "mode": "multi"
