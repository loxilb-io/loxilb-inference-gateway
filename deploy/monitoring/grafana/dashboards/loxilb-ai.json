        {
          "id": 20,
          "type": "timeseries",
          "title": "Tier-1.5 hits by endpoint",
          "description": "Per-endpoint KV cache-hit routing decisions (ep_idx = endpoint index in the LB rule). Shows how tier-1.5 exact-match routing distributes prompts across the pool - distinct prompt prefixes should pin to distinct endpoints.",
          "gridPos": {
            "h": 8,
            "w": 12,
            "x": 0,
            "y": 46
          },
          "datasource": {
            "type": "prometheus",
            "uid": "loxilb-prom"
          },
          "targets": [
            {
              "refId": "A",
              "expr": "sum by (ep_idx) (rate(loxilb_pd_kv_tier15_hits_total{instance=~\"$instance\"}[$__rate_interval]))",
              "legendFormat": "hits ep{{ep_idx}}"
            },
            {
              "refId": "B",
              "expr": "sum by (ep_idx) (rate(loxilb_pd_kv_tier15_spills_total{instance=~\"$instance\"}[$__rate_interval]))",
              "legendFormat": "spills ep{{ep_idx}}"
            }
          ],
          "options": {
            "tooltip": {
              "mode": "multi"
            },
            "legend": {
              "displayMode": "list",
              "placement": "bottom"
            }
          },
          "fieldConfig": {
            "defaults": {
              "unit": "short",
              "noValue": "No data"
            },
