[Unit]
Description=LoxiLB Inference Gateway load balancer
Documentation=https://github.com/loxilb-io/loxilb-inference-gateway
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=root
ExecStartPre=/usr/sbin/mkllb-bpffs
Environment=LOXILB_DATAPATH_STATE=/run/loxilb-datapath.json
ExecStart=/usr/sbin/loxilb
ExecStopPost=/usr/sbin/loxilb --detach-datapath=/run/loxilb-datapath.json
Restart=always
RestartSec=1
LimitMEMLOCK=infinity
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
