          }
        },
        {
          "id": 15,
          "type": "timeseries",
          "title": "Decode TTFT p95",
          "gridPos": {
            "h": 8,
            "w": 12,
            "x": 0,
            "y": 45
          },
          "datasource": {
            "type": "prometheus",
            "uid": "loxilb-prom"
          },
          "targets": [
            {
              "refId": "A",
              "expr": "histogram_quantile(0.95, sum by (le) (rate(loxilb_ai_pd_decode_ttft_seconds_bucket{instance=~\"$instance\"}[$__rate_interval])))"
            }
